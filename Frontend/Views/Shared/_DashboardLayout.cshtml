<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpendingSmart</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Header Navigation -->
    <header class="header-nav">
        <div class="header-content">
            <!-- Logo -->
            <div class="header-logo">
                <i class="bi bi-wallet-fill"></i>
                <span>SpendingSmart</span>
            </div>

            <!-- Navigation Menu -->
            <nav class="header-menu">
                <a href="@Url.Action("Dashboard", "Home")" class="menu-item active">
                    <i class="bi bi-house"></i>
                    <span>Trang chủ</span>
                </a>
                <a href="#categories" class="menu-item">
                    <i class="bi bi-tag-fill"></i>
                    <span>Danh mục</span>
                </a>
                <a href="@Url.Action("Transactions", "Home")" class="menu-item">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Lịch sử giao dịch</span>
                </a>
                <a href="#reports" class="menu-item">
                    <i class="bi bi-bar-chart"></i>
                    <span>Báo cáo</span>
                </a>
                <a href="#reminders" class="menu-item">
                    <i class="bi bi-bell"></i>
                    <span>Nhắc nhở</span>
                </a>
            </nav>

            <!-- User Section -->
            <div class="header-user">
                <div class="user-avatar-wrapper">
                    <div class="user-avatar" title="@ViewBag.UserName">
                        @(string.IsNullOrEmpty(ViewBag.UserName) ? "U" : ViewBag.UserName[0].ToString().ToUpper())
                    </div>
                    <div class="user-dropdown">
                        <a href="#settings" class="dropdown-item">
                            <i class="bi bi-gear"></i> Cài đặt
                        </a>
                        <a href="@Url.Action("Logout", "Account")" class="dropdown-item">
                            <i class="bi bi-box-arrow-left"></i> Đăng xuất
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">
                <i class="bi bi-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // User dropdown toggle
        document.querySelector('.user-avatar')?.addEventListener('click', function(e) {
            e.preventDefault();
            document.querySelector('.user-dropdown').classList.toggle('show');
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.user-avatar-wrapper')) {
                document.querySelector('.user-dropdown')?.classList.remove('show');
            }
        });

        // Set active menu item
        document.addEventListener('DOMContentLoaded', function() {
            const currentUrl = window.location.pathname;
            document.querySelectorAll('.menu-item').forEach(link => {
                if (link.href.includes(currentUrl) || 
                    (currentUrl.includes('Dashboard') && link.href.includes('Dashboard'))) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });
        });
    </script>
</body>
</html>



