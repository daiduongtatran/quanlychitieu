@model IEnumerable<Backend.Models.DanhMuc>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-title">Quản lý danh mục</h1>
        <p class="page-subtitle">Quản lý các danh mục chi tiêu và thu nhập của bạn</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
        <i class="bi bi-plus-circle"></i> Thêm danh mục mới
    </button>
</div>

<div class="card mb-4">
    <div class="card-body">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th style="width: 15%">Biểu tượng</th>
                    <th>Tên danh mục</th>
                    <th style="width: 20%" class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark p-2">
                                    <i class="@item.BieuTuong"></i>
                                </span>
                            </td>
                            <td><strong>@item.TenDanhMuc</strong></td>
                            <td class="text-center">
                                <form asp-action="Delete" asp-route-id="@item.MaDanhMuc" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này? Các giao dịch thuộc danh mục này có thể bị ảnh hưởng.');" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">Bạn chưa tạo danh mục chi tiêu nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel">Thêm danh mục mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên danh mục</label>
                        <input name="TenDanhMuc" class="form-control" placeholder="Ví dụ: Ăn uống, Di chuyển, Mua sắm..." required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Chọn biểu tượng</label>
                        <div class="icon-preview-container mb-2">
                            <div class="border rounded p-3 text-center bg-light" id="iconPreview">
                                <i class="bi bi-smiley" id="previewIcon" style="font-size: 2rem; color: #0d6efd;"></i>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#iconPickerModal">
                            <i class="bi bi-palette"></i> Chọn biểu tượng
                        </button>
                        <input type="hidden" name="BieuTuong" id="BieuTuongInput" value="bi bi-smiley" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Loại danh mục</label>
                        <select name="LoaiDanhMuc" class="form-select" required>
                            <option value="">-- Chọn phân loại --</option>
                            <option value="Chi">Chi tiêu</option>
                            <option value="Thu">Thu nhập</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu lại</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="iconPickerModal" tabindex="-1" aria-labelledby="iconPickerLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="iconPickerLabel">Chọn biểu tượng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="iconGrid" class="icon-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(50px, 1fr)); gap: 10px;">
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.icon-grid .icon-item {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #dee2e6;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 1.8rem;
    user-select: none;
}

.icon-grid .icon-item:hover {
    border-color: #0d6efd;
    background-color: #e7f1ff;
    transform: scale(1.05);
}

.icon-grid .icon-item.selected {
    border-color: #0d6efd;
    background-color: #0d6efd;
    color: white;
}

#iconPreview {
    transition: all 0.3s ease;
}
</style>

<script>
    const availableIcons = [
        { icon: 'bi bi-cup-straw', name: 'Nước uống' },
        { icon: 'bi bi-egg-fried', name: 'Ăn sáng' },
        { icon: 'bi bi-cup-hot', name: 'Cà phê' },
        { icon: 'bi bi-basket', name: 'Thực phẩm' },
        
        { icon: 'bi bi-car-front', name: 'Xe hơi' },
        { icon: 'bi bi-bicycle', name: 'Xe đạp' },
        { icon: 'bi bi-bus-front', name: 'Xe buýt' },
        { icon: 'bi bi-airplane', name: 'Máy bay' },
        
        { icon: 'bi bi-bag-check', name: 'Quần áo' },
        { icon: 'bi bi-cart-check', name: 'Mua sắm' },
        { icon: 'bi bi-shop', name: 'Cửa hàng' },
        { icon: 'bi bi-gift', name: 'Quà tặng' },
        
        { icon: 'bi bi-hospital', name: 'Bệnh viện' },
        { icon: 'bi bi-capsule', name: 'Thuốc' },
        { icon: 'bi bi-heart-pulse', name: 'Sức khỏe' },
        { icon: 'bi bi-eyeglasses', name: 'Kính mắt' },
        
        { icon: 'bi bi-book', name: 'Sách vở' },
        { icon: 'bi bi-mortarboard', name: 'Học tập' },
        { icon: 'bi bi-pencil-square', name: 'Bài tập' },
        { icon: 'bi bi-laptop', name: 'Máy tính' },
        
        { icon: 'bi bi-house', name: 'Nhà ở' },
        { icon: 'bi bi-lightbulb', name: 'Điện' },
        { icon: 'bi bi-droplet', name: 'Nước' },
        { icon: 'bi bi-tools', name: 'Sửa chữa' },
        
        { icon: 'bi bi-briefcase', name: 'Lương' },
        { icon: 'bi bi-coin', name: 'Tiền xu' },
        { icon: 'bi bi-graph-up', name: 'Đầu tư' },
        { icon: 'bi bi-piggy-bank', name: 'Tiết kiệm' },
        { icon: 'bi bi-cash-coin', name: 'Tiền mặt' },
        
        { icon: 'bi bi-question-circle', name: 'Khác' },
        { icon: 'bi bi-star', name: 'Yêu thích' },
        { icon: 'bi bi-heart', name: 'Yêu thương' },
        { icon: 'bi bi-emoji-smile', name: 'Vui vẻ' },
    ];

    let currentIcons = availableIcons;

    function initializeIconPicker() {
        renderIcons(availableIcons);
    }

    function renderIcons(icons) {
        const grid = document.getElementById('iconGrid');
        const currentValue = document.getElementById('BieuTuongInput').value;
        
        grid.innerHTML = '';
        icons.forEach(item => {
            const div = document.createElement('div');
            div.className = 'icon-item' + (item.icon === currentValue ? ' selected' : '');
            div.title = item.name;
            div.innerHTML = '<i class="' + item.icon + '"></i>';
            
            div.addEventListener('click', function() {
                selectIcon(item.icon);
            });
            
            grid.appendChild(div);
        });
    }

    function selectIcon(iconClass) {
        document.getElementById('BieuTuongInput').value = iconClass;
        
        const previewIcon = document.getElementById('previewIcon');
        previewIcon.className = iconClass;
        
        document.querySelectorAll('.icon-item').forEach(item => {
            item.classList.remove('selected');
            if (item.querySelector('i').className === iconClass) {
                item.classList.add('selected');
            }
        });
        
        const iconPickerModalEl = document.getElementById('iconPickerModal');
        const createModalEl = document.getElementById('createModal');
        
        const handler = function() {
            const createModal = bootstrap.Modal.getInstance(createModalEl);
            if (!createModal) {
                new bootstrap.Modal(createModalEl).show();
            } else {
                createModal.show();
            }
            const nameInput = createModalEl.querySelector('input[name="TenDanhMuc"]');
            if (nameInput) {
                setTimeout(() => nameInput.focus(), 100);
            }
            iconPickerModalEl.removeEventListener('hidden.bs.modal', handler);
        };
        
        iconPickerModalEl.addEventListener('hidden.bs.modal', handler);
        const iconPickerModal = bootstrap.Modal.getInstance(iconPickerModalEl);
        if (iconPickerModal) {
            iconPickerModal.hide();
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        initializeIconPicker();
        
        const iconPickerModalEl = document.getElementById('iconPickerModal');
        
        iconPickerModalEl.addEventListener('show.bs.modal', function() {
            document.querySelector('.modal-backdrop')?.style.setProperty('opacity', '0.3', 'important');
        });
    });
</script>