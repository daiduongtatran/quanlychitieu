@{
    ViewData["Title"] = "Trang chủ - Quản lý chi tiêu";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center gy-5 py-5">
            <div class="col-lg-6">
                <div class="mb-4">
                    <span class="badge bg-success-light text-success px-3 py-2 mb-3" style="font-size: 0.95rem; font-weight: 600;">✓ Được tin cậy bởi hàng ngàn người dùng</span>
                </div>
                <h1 class="display-3 fw-bold mb-3 text-dark" style="line-height: 1.2;">
                    Quản lý chi tiêu,<br>kiểm soát tài chính
                </h1>
                <p class="lead text-muted mb-4" style="font-size: 1.1rem; line-height: 1.8;">
                    Ứng dụng quản lý chi tiêu giúp bạn theo dõi mỗi khoản tiêu dùng, lập ngân sách, và đạt mục tiêu tài chính cá nhân.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/Account/Register" class="btn btn-success btn-lg px-5 fw-bold shadow-sm" style="font-size: 1rem; padding: 12px 40px !important;">
                        Bắt đầu ngay
                    </a>
                </div>
                <div class="mt-5 pt-3">
                    <p class="text-muted" style="font-size: 0.9rem;">
                        <i class="bi bi-shield-check" style="color: #27ae60; margin-right: 8px;"></i>Bảo mật SSL<span class="mx-3">•</span>
                        <i class="bi bi-graph-up" style="color: #27ae60; margin-right: 8px;"></i>Báo cáo chi tiết<span class="mx-3">•</span>
                        <i class="bi bi-lightning-fill" style="color: #27ae60; margin-right: 8px;"></i>Nhanh chóng
                    </p>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="hero-illustration" style="padding: 40px; background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%); border-radius: 20px; border: 2px solid #e0e0e0;">
                    <!-- Icons removed -->
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-2 display-5">Tính năng chính</h2>
            <p class="text-muted fs-5">Mọi công cụ bạn cần để quản lý tài chính hiệu quả</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="feature-card h-100">
                    <div class="feature-icon bg-success-light">📝</div>
                    <h4 class="fw-bold mt-3">Ghi chép nhanh</h4>
                    <p class="text-muted">Nhập giao dịch thu chi nhanh chóng, chi tiết mọi lúc mọi nơi chỉ trong vài giây.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card h-100">
                    <div class="feature-icon bg-info-light">📊</div>
                    <h4 class="fw-bold mt-3">Báo cáo chi tiết</h4>
                    <p class="text-muted">Biểu đồ trực quan và báo cáo toàn diện giúp phân tích thói quen tiêu xài.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card h-100">
                    <div class="feature-icon bg-warning-light">🎯</div>
                    <h4 class="fw-bold mt-3">Lập ngân sách</h4>
                    <p class="text-muted">Đặt giới hạn chi tiêu cho từng danh mục để kiểm soát chi tiêu hiệu quả.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card h-100">
                    <div class="feature-icon bg-danger-light">🔔</div>
                    <h4 class="fw-bold mt-3">Thông báo thông minh</h4>
                    <p class="text-muted">Nhận cảnh báo khi chi tiêu vượt ngân sách hoặc đạt mục tiêu tiết kiệm.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-5">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="stat-card">
                    <h3 class="display-5 fw-bold text-success">10K+</h3>
                    <p class="text-muted fs-5">Người dùng đang sử dụng</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <h3 class="display-5 fw-bold text-success">500M+</h3>
                    <p class="text-muted fs-5">Giao dịch được xử lý</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <h3 class="display-5 fw-bold text-success">4.8⭐</h3>
                    <p class="text-muted fs-5">Đánh giá từ người dùng</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Us Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-2 display-5">Tại sao chọn Quản lý chi tiêu?</h2>
            <p class="text-muted fs-5">Mọi thứ bạn cần để kiểm soát tài chính của mình</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="benefit-card h-100">
                    <div class="benefit-icon">
                        <i class="bi bi-lightning-fill"></i>
                    </div>
                    <h5 class="fw-bold mt-3 mb-2">Dễ sử dụng</h5>
                    <p class="text-muted small">Giao diện trực quan, không cần đào tạo phức tạp</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="benefit-card h-100">
                    <div class="benefit-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h5 class="fw-bold mt-3 mb-2">Bảo mật cao</h5>
                    <p class="text-muted small">Mã hóa SSL, bảo mật 2 lớp, tuân thủ GDPR</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="benefit-card h-100">
                    <div class="benefit-icon">
                        <i class="bi bi-headset"></i>
                    </div>
                    <h5 class="fw-bold mt-3 mb-2">Hỗ trợ tuyệt vời</h5>
                    <p class="text-muted small">Đội ngũ hỗ trợ sẵn sàng 24/7 cho bạn</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="benefit-card h-100">
                    <div class="benefit-icon">
                        <i class="bi bi-gift"></i>
                    </div>
                    <h5 class="fw-bold mt-3 mb-2">Miễn phí vĩnh viễn</h5>
                    <p class="text-muted small">Dùng không giới hạn mà không cần thanh toán</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-5 bg-gradient">
    <div class="container text-center">
        <h2 class="display-5 fw-bold mb-3 text-white">Sẵn sàng quản lý tài chính của bạn?</h2>
        <p class="lead text-white-50 mb-4 fs-5">Tham gia hàng ngàn người dùng đang tối ưu hóa tài chính cá nhân của họ</p>
        <a href="/Account/Register" class="btn btn-light btn-lg px-5 fw-bold">
            Đăng ký ngay - Hoàn toàn miễn phí
        </a>
    </div>
</section>