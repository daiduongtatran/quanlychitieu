@model Backend.Models.NguoiDung

@{
    ViewData["Title"] = "Trang chủ - SpendingSmart";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var recentTransactions = ViewBag.RecentTransactions ?? new List<dynamic>();
    var expenseByCategory = ViewBag.ExpenseByCategory ?? new List<dynamic>();
    var budgetByCategory = ViewBag.BudgetByCategory ?? new List<dynamic>();
    decimal monthExpense = ViewBag.MonthExpense ?? 0m;
    decimal monthBudget = ViewBag.MonthBudget ?? 0m;

    // Helper function to convert Bootstrap Icon class to emoji
    Func<string, string> ConvertIconToEmoji = (icon) =>
    {
        if (string.IsNullOrEmpty(icon)) return "❓";
        
        var iconMap = new Dictionary<string, string>
        {
            { "bi bi-cup-hot", "☕" },
            { "bi bi-car-front", "🚗" },
            { "bi bi-cart-check", "🛒" },
            { "bi bi-heart-pulse", "❤️" },
            { "bi bi-book", "📚" },
            { "bi bi-house", "🏠" },
            { "bi bi-film", "🎬" },
            { "bi bi-question-circle", "❓" },
            { "bi bi-briefcase", "💼" },
            { "bi bi-gift", "🎁" },
            { "bi bi-graph-up", "📈" },
            { "bi bi-wallet2", "👛" },
            { "bi bi-piggy-bank", "🐷" }
        };
        
        return iconMap.ContainsKey(icon) ? iconMap[icon] : icon;
    };
}

<div class="page-header mb-4">
    <h1 class="page-title">Xin chào, <strong>@ViewBag.UserName</strong>! 👋</h1>
    <p class="page-subtitle">@DateTime.Now.ToString("dddd, dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</p>
</div>

<div class="row mb-2">
    <div class="col-md-12">
        <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="stat-icon">
                <i class="bi bi-piggy-bank"></i>
            </div>
            <div class="stat-content">
                <h5>Số dư tài khoản</h5>
                <p class="stat-value">@(((decimal)(ViewBag.AccountBalance ?? 0)).ToString("N0")) VNĐ</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="stat-card icon-expense">
            <div class="stat-icon">
                <i class="bi bi-arrow-down-circle"></i>
            </div>
            <div class="stat-content">
                <h5>Chi tiêu hôm nay</h5>
                <p class="stat-value">@(ViewBag.TodayExpense == null ? "0" : ((decimal)ViewBag.TodayExpense).ToString("N0")) VNĐ</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="stat-card icon-budget">
            <div class="stat-icon">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="stat-content">
                <h5>Chi tiêu tháng</h5>
                <p class="stat-value">@monthExpense.ToString("N0") VNĐ</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#nganSachModal" class="text-reset text-decoration-none">
            <div class="stat-card icon-category" style="cursor: pointer;">
                <div class="stat-icon">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <div class="stat-content">
                    <h5>Ngân sách tháng</h5>
                    <p class="stat-value">@monthBudget.ToString("N0") VNĐ</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-3 mb-4">
        <a asp-controller="Home" asp-action="Transactions" class="text-reset text-decoration-none">
            <div class="stat-card icon-transaction" style="cursor: pointer; transition: all 0.2s ease;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <div class="stat-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div class="stat-content">
                    <h5>Tổng giao dịch</h5>
                    <p class="stat-value">@ViewBag.TransactionCount</p>
                </div>
            </div>
        </a>
    </div>
    
    <div class="col-md-3 mb-4">
        <div class="stat-card" 
             data-bs-toggle="modal" 
             data-bs-target="#modalThemGiaoDich" 
             style="cursor: pointer; transition: all 0.2s ease;" 
             onmouseover="this.style.transform='translateY(-3px)'" 
             onmouseout="this.style.transform='translateY(0)'">
            
            <div class="stat-icon text-success">
                <i class="bi bi-plus-circle-fill"></i>
            </div>
            
            <div class="stat-content">
                <h5 class="text-success fw-bold">Thêm giao dịch</h5>
                <p class="text-muted m-0" style="font-size: 0.875rem;">Nhập khoản chi mới</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-8 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history"></i> Giao dịch gần đây
                </h5>
            </div>
            <div class="card-body">
                @if (recentTransactions.Count == 0)
                {
                    <div class="alert alert-info">
                    Chưa có giao dịch nào. Bắt đầu 
                    <a href="javascript:void(0);" class="text-decoration-underline fw-bold" data-bs-toggle="modal" data-bs-target="#modalThemGiaoDich">
                        them giao dịch
                    </a> 
                    để quản lý chi tiêu của bạn.
                    </div>
                }
                else
                {
                    <div class="transaction-list">
                        @foreach (var transaction in recentTransactions)
                        {
                            <div class="transaction-item">
                                <div class="transaction-info">
                                    <div class="transaction-icon">
                                        @if (!string.IsNullOrEmpty(transaction.BieuTuong))
                                        {
                                            <span style="font-size: 1.4em;">@ConvertIconToEmoji(transaction.BieuTuong)</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cash-flow"></i>
                                        }
                                    </div>
                                    <div class="transaction-details">
                                        <p class="transaction-category">@transaction.TenDanhMuc</p>
                                        <p class="transaction-note">@transaction.GhiChu</p>
                                        <p class="transaction-date">@transaction.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>
                                </div>
                                <div class="transaction-amount">
                                    <p class="amount">-@(((decimal)transaction.SoTien).ToString("N0")) VNĐ</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-pie-chart"></i> Thống kê chi tiêu
                </h5>
            </div>
            <div class="card-body">
                @if (monthBudget > 0)
                {
                    <div class="budget-status">
                        <div class="budget-progress">
                            <div class="progress-info">
                                <span class="spent-label">Đã chi tiêu</span>
                                <span class="spent-value">@monthExpense.ToString("N0") VNĐ</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @(monthExpense > monthBudget ? "bg-danger" : "bg-success")"
                                     role="progressbar"
                                     style="width: @((Math.Min((monthExpense / monthBudget * 100), 100)).ToString("F0"))%"
                                     aria-valuenow="@monthExpense" aria-valuemin="0" aria-valuemax="@monthBudget">
                                </div>
                            </div>
                            <div class="progress-info">
                                <span>Ngân sách: @monthBudget.ToString("N0") VNĐ</span>
                                <span class="remaining @(monthExpense > monthBudget ? "text-danger" : "text-success")">
                                    @if (monthExpense > monthBudget)
                                    {
                                        <span>Vượt: @((monthExpense - monthBudget).ToString("N0")) VNĐ</span>
                                    }
                                    else
                                    {
                                        <span>Còn lại: @((monthBudget - monthExpense).ToString("N0")) VNĐ</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> Bạn chưa thiết lập ngân sách cho tháng này. Hãy 
                        <a href="#" class="text-decoration-underline fw-bold text-warning-emphasis" data-bs-toggle="modal" data-bs-target="#nganSachModal">thiết lập</a> ngay!
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-bar-chart"></i> Chi tiêu theo danh mục (tháng này)
                </h5>
            </div>
            <div class="card-body">
                @if (expenseByCategory.Count == 0)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Chưa có chi tiêu nào
                    </div>
                }
                else
                {
                    <div class="category-list">
                        @foreach (var category in expenseByCategory)
                        {
                            <div class="category-item">
                                <div class="category-info">
                                    <span class="category-icon">
                                        @if (!string.IsNullOrEmpty(category.Icon))
                                        {
                                            <span style="font-size: 1.2em;">@ConvertIconToEmoji(category.Icon)</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-folder"></i>
                                        }
                                    </span>
                                    <div class="category-details">
                                        <p class="category-name">@category.Category</p>
                                        <p class="category-count">@category.Count giao dịch</p>
                                    </div>
                                </div>
                                <p class="category-amount">@(((decimal)category.Total).ToString("N0")) VNĐ</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-target"></i> Trạng thái ngân sách
                </h5>
            </div>
            <div class="card-body">
                @if (budgetByCategory.Count == 0)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Chưa có ngân sách nào
                    </div>
                }
                else
                {
                    <div class="category-list">
                        @foreach (var budget in budgetByCategory)
                        {
                            decimal spent = budget.Spent ?? 0m;
                            decimal limit = budget.BudgetLimit ?? 0m;
                            double percentage = limit > 0 ? (double)(spent / limit * 100) : 0;
                            string statusClass = spent > limit ? "danger" : (spent > limit * 0.8m ? "warning" : "success");

                            <div class="category-item">
                                <div class="category-info">
                                    <span class="category-icon">
                                        @if (!string.IsNullOrEmpty(budget.Icon))
                                        {
                                            <span style="font-size: 1.2em;">@ConvertIconToEmoji(budget.Icon)</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-folder"></i>
                                        }
                                    </span>
                                    <div class="category-details">
                                        <p class="category-name">@budget.Category</p>
                                        <p class="category-budget">@spent.ToString("N0") / @limit.ToString("N0") VNĐ</p>
                                    </div>
                                </div>
                                <div class="budget-mini-progress">
                                    <div class="progress" style="height: 4px;">
                                        <div class="progress-bar bg-@statusClass" style="width: @((Math.Min(percentage, 100)).ToString("F0"))%"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalThemGiaoDich" tabindex="-1" aria-labelledby="modalThemGiaoDichLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalThemGiaoDichLabel">➕ Thêm Giao Dịch Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Home" asp-action="ThemGiaoDich" method="post">
                <div class="modal-body" style="max-height: calc(100vh - 200px); overflow-y: auto;">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền (VNĐ)</label>
                        <input type="number" name="SoTien" class="form-control" placeholder="Ví dụ: 50000" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngày giao dịch</label>
                        <input type="date" name="NgayGiaoDich" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isDinhKy" name="IsDinhKy" value="true">
                            <label class="form-check-label fw-bold" for="isDinhKy">🔄 Giao dịch định kỳ</label>
                        </div>
    
                        <div id="khuVucDinhKy" class="d-none p-3 border rounded bg-light mt-2 animate__animated animate__fadeIn">
                            <div class="mb-2">
                                <label class="form-label small fw-bold text-secondary">Tần suất lặp lại</label>
                                <select name="TanSuat" class="form-select form-select-sm">
                                    <option value="HangNgay">Hàng ngày</option>
                                    <option value="HangTuan">Hàng tuần</option>
                                    <option value="HangThang" selected>Hàng tháng</option>
                                    <option value="HangNam">Hàng năm</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label small fw-bold text-secondary">Ngày kết thúc lặp (Không bắt buộc)</label>
                                <input type="date" name="NgayKetThuc" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú / Mô tả</label>
                        <textarea name="GhiChu" class="form-control" rows="2" placeholder="Ví dụ: Mua cơm trưa..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục chi tiêu</label>
                        <select name="MaDanhMuc" class="form-select category-select" id="categorySelect" required>
                            <option value="">-- Chọn danh mục --</option>
                            @if (ViewBag.DanhSachDanhMuc != null)
                            {
                                var chiTieuGroups = ((System.Collections.Generic.List<Backend.Models.DanhMuc>)ViewBag.DanhSachDanhMuc)
                                    .GroupBy(x => x.LoaiDanhMuc ?? "Khác")
                                    .OrderBy(g => g.Key);

                                foreach (var group in chiTieuGroups)
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var dm in group)
                                        {
                                            <option value="@dm.MaDanhMuc" data-icon="@dm.BieuTuong" data-name="@dm.TenDanhMuc">
                                                @dm.TenDanhMuc
                                            </option>
                                        }
                                    </optgroup>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Lưu giao dịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="nganSachModal" tabindex="-1" aria-labelledby="nganSachModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="nganSachModalLabel">
                    <i class="bi bi-wallet2 me-2"></i>Thiết lập ngân sách mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Home" asp-action="ThemNganSach" method="post">
                <div class="modal-body">
                    
                    <div class="mb-3 p-2 bg-light rounded border">
                        <label class="form-label fw-bold text-dark d-block mb-2">Loại ngân sách áp dụng</label>
                        <div class="d-flex gap-4 justify-content-center">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="LoaiNganSach" id="radNganSachThang" value="Thang" checked>
                                <label class="form-check-label fw-bold text-primary" for="radNganSachThang" style="cursor:pointer;">
                                    💳 Tổng chi tiêu tháng
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="LoaiNganSach" id="radNganSachDanhMuc" value="DanhMuc">
                                <label class="form-check-label fw-bold text-success" for="radNganSachDanhMuc" style="cursor:pointer;">
                                    🏷️ Theo danh mục chi tiết
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="khuVucChonDanhMuc">
                        <label class="form-label fw-bold">Áp dụng cho danh mục</label>
                        <select name="MaDanhMuc" id="selectMaDanhMuc" class="form-select">
                            <option value="">-- Chọn danh mục chi tiêu --</option>
                            @if (ViewBag.DanhMucList != null)
                            {
                                foreach (var dm in ViewBag.DanhMucList)
                                {
                                    <option value="@dm.MaDanhMuc">@dm.TenDanhMuc</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền hạn mức tối đa (đ)</label>
                        <input type="number" name="SoTienHanMuc" class="form-control" placeholder="Ví dụ: 2000000" min="1000" required />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Từ ngày</label>
                            <input type="date" name="NgayBatDau" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-01")" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Đến ngày</label>
                            <input type="date" name="NgayKetThuc" class="form-control" value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd"))" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark">Lưu cài đặt</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const radThang = document.getElementById("radNganSachThang");
        const radDanhMuc = document.getElementById("radNganSachDanhMuc");
        const khuVucDanhMuc = document.getElementById("khuVucChonDanhMuc");
        const selectDanhMuc = document.getElementById("selectMaDanhMuc");

        function toggleBudgetType() {
            if (radThang.checked) {
                khuVucDanhMuc.classList.add("d-none"); 
                selectDanhMuc.removeAttribute("required"); 
                selectDanhMuc.value = ""; 
            } else if (radDanhMuc.checked) {
                khuVucDanhMuc.classList.remove("d-none"); 
                selectDanhMuc.setAttribute("required", "required"); 
            }
        }

        radThang.addEventListener("change", toggleBudgetType);
        radDanhMuc.addEventListener("change", toggleBudgetType);
        
        
        toggleBudgetType();
    });
</script>

<style>
    .modal-backdrop {
        z-index: 1040 !important;
    }
    #modalThemGiaoDich, #nganSachModal {
        z-index: 1055 !important;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const checkboxDinhKy = document.getElementById("isDinhKy");
        const khuVucDinhKy = document.getElementById("khuVucDinhKy");

        if (checkboxDinhKy && khuVucDinhKy) {
            checkboxDinhKy.addEventListener("change", function () {
                if (this.checked) {
                    khuVucDinhKy.classList.remove("d-none");
                } else {
                    khuVucDinhKy.classList.add("d-none");
                }
            });
        }

        // Icon conversion map
        const iconMap = {
            "bi bi-cup-hot": "☕",
            "bi bi-car-front": "🚗",
            "bi bi-cart-check": "🛒",
            "bi bi-heart-pulse": "❤️",
            "bi bi-book": "📚",
            "bi bi-house": "🏠",
            "bi bi-film": "🎬",
            "bi bi-question-circle": "❓",
            "bi bi-briefcase": "💼",
            "bi bi-gift": "🎁",
            "bi bi-graph-up": "📈",
            "bi bi-wallet2": "👛",
            "bi bi-piggy-bank": "🐷"
        };

        const convertIcon = (icon) => {
            // If already emoji (contains emoji character), return as is
            if (/[\u{1F300}-\u{1F9FF}]|[\u2600-\u26FF]/u.test(icon)) {
                return icon;
            }
            return iconMap[icon] || icon;
        };

        const categorySelect = document.getElementById("categorySelect");
        if (categorySelect) {
            const container = categorySelect.parentElement;
            container.style.position = "relative"; 
            const customSelect = document.createElement('div');
            customSelect.className = 'custom-select-wrapper';
            
            const selected = document.createElement('div');
            selected.className = 'custom-select-selected';
            
            const dropdown = document.createElement('div');
            dropdown.className = 'custom-select-items';
            Array.from(categorySelect.options).forEach((option, index) => {
                if (index === 0 && option.value === '') return; 
                
                const item = document.createElement('div');
                item.className = 'custom-select-item';
                item.setAttribute('data-value', option.value);
                item.setAttribute('data-icon', option.getAttribute('data-icon') || '');
                item.setAttribute('data-text', option.textContent);
                
                const icon = option.getAttribute('data-icon');
                const convertedIcon = convertIcon(icon);
                if (convertedIcon && convertedIcon !== icon) {
                    item.innerHTML = `<span style="font-size: 1.2em; margin-right: 8px;">${convertedIcon}</span><span>${option.textContent}</span>`;
                } else if (icon && icon.includes('bi bi-')) {
                    item.innerHTML = `<span style="font-size: 1.2em; margin-right: 8px;">${convertedIcon}</span><span>${option.textContent}</span>`;
                } else {
                    item.textContent = option.textContent;
                }
                
                item.addEventListener('click', function() {
                    categorySelect.value = this.getAttribute('data-value');
                    updateSelected();
                    dropdown.classList.remove('active');
                });
                
                dropdown.appendChild(item);
            });
            
            const updateSelected = () => {
                const selectedOption = categorySelect.options[categorySelect.selectedIndex];
                const icon = selectedOption.getAttribute('data-icon');
                const text = selectedOption.textContent;
                const convertedIcon = convertIcon(icon);
                
                if (convertedIcon && convertedIcon !== icon) {
                    selected.innerHTML = `<span style="font-size: 1.2em; margin-right: 8px;">${convertedIcon}</span><span>${text}</span>`;
                } else if (icon && icon.includes('bi bi-')) {
                    selected.innerHTML = `<span style="font-size: 1.2em; margin-right: 8px;">${convertedIcon}</span><span>${text}</span>`;
                } else {
                    selected.textContent = text;
                }
            };
            
            selected.addEventListener('click', function(e) {
                e.stopPropagation();
                dropdown.classList.toggle('active');
            });
            
            customSelect.appendChild(selected);
            customSelect.appendChild(dropdown);
            container.insertBefore(customSelect, categorySelect);
            categorySelect.style.display = 'none';
            
            updateSelected();
            
            document.addEventListener('click', function(e) {
                if (!customSelect.contains(e.target)) {
                    dropdown.classList.remove('active');
                }
            });
        }
    });
</script>

