@model Backend.Models.NguoiDung

@{
    var recentTransactions = ViewBag.RecentTransactions ?? new List<dynamic>();
    var expenseByCategory = ViewBag.ExpenseByCategory ?? new List<dynamic>();
    var budgetByCategory = ViewBag.BudgetByCategory ?? new List<dynamic>();
    var categoryBudgetInfo = ViewBag.CategoryBudgetInfo as System.Collections.Generic.Dictionary<int, dynamic> ?? new Dictionary<int, dynamic>();
    decimal monthExpense = ViewBag.MonthExpense ?? 0m;
    decimal monthBudget = ViewBag.MonthBudget ?? 0m;
}

<div class="page-header mb-4" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h1 class="page-title">Xin chào, <strong>@ViewBag.UserName</strong>! 👋</h1>
        <p class="page-subtitle">@DateTime.Now.ToString("dddd, dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</p>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="stat-card icon-expense">
            <div class="stat-icon">
                <i class="bi bi-arrow-down-circle"></i>
            </div>
            <div class="stat-content">
                <h5>Chi tiêu hôm nay</h5>
                <p class="stat-value">@(ViewBag.TodayExpense == null ? "0" : ((decimal)ViewBag.TodayExpense).ToString("N0")) VNĐ</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="stat-card icon-budget">
            <div class="stat-icon">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="stat-content">
                <h5>Chi tiêu tháng</h5>
                <p class="stat-value">@monthExpense.ToString("N0") VNĐ</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#nganSachModal" class="text-reset text-decoration-none">
            <div class="stat-card icon-category" style="cursor: pointer;">
                <div class="stat-icon">
                    <i class="bi bi-tag-fill"></i>
                </div>
                <div class="stat-content">
                    <h5>Ngân sách tháng</h5>
                    <p class="stat-value">@monthBudget.ToString("N0") VNĐ</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-3 mb-4">
        <a asp-controller="Home" asp-action="Transactions" class="text-reset text-decoration-none">
            <div class="stat-card icon-transaction" style="cursor: pointer;">
                <div class="stat-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div class="stat-content">
                    <h5>Tổng giao dịch</h5>
                    <p class="stat-value">@ViewBag.TransactionCount</p>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Budget by Category & Add Transaction Section -->
<div class="row mt-3">
    <div class="col-md-6 mb-4">
        <div class="card card-action-section" style="border: 2px dashed #28a745; background: linear-gradient(135deg, rgba(40, 167, 69, 0.05) 0%, rgba(40, 167, 69, 0.02) 100%); cursor: pointer;" data-bs-toggle="modal" data-bs-target="#nganSachDanhMucModal">
            <div class="card-body text-center py-4">
                <div style="font-size: 2.5rem; margin-bottom: 10px;">
                    <i class="bi bi-plus-circle-fill text-success"></i>
                </div>
                <h5 class="text-success fw-bold">Đặt ngân sách danh mục</h5>
                <p class="text-muted mb-0">Quản lý ngân sách theo từng loại chi tiêu</p>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card card-action-section" style="border: 2px dashed #0d6efd; background: linear-gradient(135deg, rgba(13, 110, 253, 0.05) 0%, rgba(13, 110, 253, 0.02) 100%); cursor: pointer;" data-bs-toggle="modal" data-bs-target="#modalThemGiaoDich">
            <div class="card-body text-center py-4">
                <div style="font-size: 2.5rem; margin-bottom: 10px;">
                    <i class="bi bi-plus-circle-fill text-primary"></i>
                </div>
                <h5 class="text-primary fw-bold">Thêm giao dịch</h5>
                <p class="text-muted mb-0">Ghi lại khoản chi tiêu mới</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-12 mb-4">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-tag"></i> Danh mục chi tiêu
                </h5>
            </div>
            <div class="card-body">
                @{
                    var categories = ViewBag.DanhMucList as System.Collections.Generic.List<Backend.Models.DanhMuc>;
                }
                @if (categories != null && categories.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr style="background-color: #f8f9fa;">
                                    <th style="width: 10%;">Biểu tượng</th>
                                    <th style="width: 30%;">Tên danh mục</th>
                                    <th style="width: 25%;">Ngân sách chi tiêu</th>
                                    <th style="width: 15%;">Loại</th>
                                    <th style="width: 20%;" class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in categories)
                                {
                                    var hasBudget = category.MaDanhMuc.HasValue && categoryBudgetInfo.ContainsKey(category.MaDanhMuc.Value) && categoryBudgetInfo[category.MaDanhMuc.Value] != null;
                                    var budgetAmount = hasBudget ? categoryBudgetInfo[category.MaDanhMuc.Value].SoTienHanMuc : 0m;
                                    
                                    <tr>
                                        <td>
                                            <span style="font-size: 1.2rem;">
                                                @if (!string.IsNullOrEmpty(category.BieuTuong))
                                                {
                                                    <i class="@category.BieuTuong"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-folder"></i>
                                                }
                                            </span>
                                        </td>
                                        <td><strong>@category.TenDanhMuc</strong></td>
                                        <td>
                                            @if (hasBudget)
                                            {
                                                <a href="javascript:void(0)" 
                                                   onclick="showBudgetDetail(@(category.MaDanhMuc.HasValue ? category.MaDanhMuc.Value : 0), '@category.TenDanhMuc', @budgetAmount, '@categoryBudgetInfo[category.MaDanhMuc.Value].NgayBatDau.ToString("dd/MM/yyyy")', '@categoryBudgetInfo[category.MaDanhMuc.Value].NgayKetThuc.ToString("dd/MM/yyyy")')"
                                                   style="cursor: pointer; color: #28a745; font-weight: bold; text-decoration: none;">
                                                    @budgetAmount.ToString("N0") đ
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="javascript:void(0)" 
                                                   onclick="showNoBudgetAlert('@category.TenDanhMuc')"
                                                   style="cursor: pointer; color: #ccc; text-decoration: none;">
                                                    0 đ
                                                </a>
                                            }
                                        </td>
                                        <td>
                                            @if (category.LoaiDanhMuc == "Chi")
                                            {
                                                <span class="badge bg-danger">Chi tiêu</span>
                                            }
                                            else if (category.LoaiDanhMuc == "Thu")
                                            {
                                                <span class="badge bg-success">Thu nhập</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@category.LoaiDanhMuc</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Danhmuc" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i> Quản lý
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info m-0">
                        <i class="bi bi-info-circle"></i> Bạn chưa tạo danh mục nào. 
                        <a href="@Url.Action("Index", "Danhmuc")" class="text-decoration-underline fw-bold">
                            Bấm vào đây để tạo danh mục mới
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-12 mb-4">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history"></i> Giao dịch gần đây
                </h5>
            </div>
            <div class="card-body">
                @if (recentTransactions.Count == 0)
                {
                    <div class="alert alert-info m-0">
                        <i class="bi bi-info-circle"></i> Chưa có giao dịch nào. Bắt đầu 
                        <a href="javascript:void(0);" class="text-decoration-underline fw-bold" data-bs-toggle="modal" data-bs-target="#modalThemGiaoDich">
                            thêm giao dịch
                        </a> 
                        để quản lý chi tiêu của bạn.
                    </div>
                }
                else
                {
                    <div class="transaction-list">
                        @foreach (var transaction in recentTransactions)
                        {
                            <div class="transaction-item">
                                <div class="transaction-info">
                                    <div class="transaction-icon">
                                        @if (!string.IsNullOrEmpty(transaction.BieuTuong))
                                        {
                                            <span>@Html.Raw(transaction.BieuTuong)</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cash-flow"></i>
                                        }
                                    </div>
                                    <div class="transaction-details">
                                        <p class="transaction-category">@transaction.TenDanhMuc</p>
                                        <p class="transaction-note">@transaction.GhiChu</p>
                                        <p class="transaction-date">@transaction.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")</p>
                                    </div>
                                </div>
                                <div class="transaction-amount">
                                    <p class="amount">-@(((decimal)transaction.SoTien).ToString("N0")) VNĐ</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalThemGiaoDich" tabindex="-1" aria-labelledby="modalThemGiaoDichLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalThemGiaoDichLabel">➕ Thêm Giao Dịch Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Home" asp-action="ThemGiaoDich" method="post">
                <div class="modal-body" style="max-height: calc(100vh - 200px); overflow-y: auto;">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền (VNĐ)</label>
                        <input type="number" name="SoTien" class="form-control" placeholder="Ví dụ: 50000" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngày giao dịch</label>
                        <input type="date" name="NgayGiaoDich" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isDinhKy" name="IsDinhKy" value="true">
                            <label class="form-check-label fw-bold" for="isDinhKy">🔄 Giao dịch định kỳ</label>
                        </div>
    
                        <div id="khuVucDinhKy" class="d-none p-3 border rounded bg-light mt-2 animate__animated animate__fadeIn">
                            <div class="mb-2">
                                <label class="form-label small fw-bold text-secondary">Tần suất lặp lại</label>
                                <select name="TanSuat" class="form-select form-select-sm">
                                    <option value="HangNgay">Hàng ngày</option>
                                    <option value="HangTuan">Hàng tuần</option>
                                    <option value="HangThang" selected>Hàng tháng</option>
                                    <option value="HangNam">Hàng năm</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label small fw-bold text-secondary">Ngày kết thúc lặp (Không bắt buộc)</label>
                                <input type="date" name="NgayKetThuc" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú / Mô tả</label>
                        <textarea name="GhiChu" class="form-control" rows="2" placeholder="Ví dụ: Mua cơm trưa..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Danh mục chi tiêu</label>
                        <select name="MaDanhMuc" class="form-select category-select" id="categorySelect" required>
                            <option value="">-- Chọn danh mục --</option>
                            @if (ViewBag.DanhSachDanhMuc != null)
                            {
                                var chiTieuGroups = ((System.Collections.Generic.List<Backend.Models.DanhMuc>)ViewBag.DanhSachDanhMuc)
                                    .GroupBy(x => x.LoaiDanhMuc ?? "Khác")
                                    .OrderBy(g => g.Key);

                                foreach (var group in chiTieuGroups)
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var dm in group)
                                        {
                                            <option value="@dm.MaDanhMuc" data-icon="@dm.BieuTuong" data-name="@dm.TenDanhMuc">
                                                @dm.TenDanhMuc
                                            </option>
                                        }
                                    </optgroup>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Lưu giao dịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="nganSachModal" tabindex="-1" aria-labelledby="nganSachModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="nganSachModalLabel">
                    <i class="bi bi-wallet2 me-2"></i>Thiết lập ngân sách mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Home" asp-action="ThemNganSach" method="post">
                <div class="modal-body">
                    
                    <div class="mb-3 p-2 bg-light rounded border">
                        <label class="form-label fw-bold text-dark d-block mb-2">Loại ngân sách áp dụng</label>
                        <div class="d-flex gap-4 justify-content-center">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="LoaiNganSach" id="radNganSachThang" value="Thang" checked>
                                <label class="form-check-label fw-bold text-primary" for="radNganSachThang" style="cursor:pointer;">
                                    💳 Tổng chi tiêu tháng
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="LoaiNganSach" id="radNganSachDanhMuc" value="DanhMuc">
                                <label class="form-check-label fw-bold text-success" for="radNganSachDanhMuc" style="cursor:pointer;">
                                    🏷️ Theo danh mục chi tiết
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 d-none" id="khuVucChonDanhMuc">
                        <label class="form-label fw-bold">Áp dụng cho danh mục</label>
                        <select name="MaDanhMuc" id="selectMaDanhMuc" class="form-select">
                            <option value="">-- Chọn danh mục chi tiêu --</option>
                            @if (ViewBag.DanhMucList != null)
                            {
                                foreach (var dm in ViewBag.DanhMucList)
                                {
                                    <option value="@dm.MaDanhMuc">@dm.BieuTuong @dm.TenDanhMuc</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền hạn mức tối đa (đ)</label>
                        <input type="number" name="SoTienHanMuc" class="form-control" placeholder="Ví dụ: 2000000" min="1000" required />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Từ ngày</label>
                            <input type="date" name="NgayBatDau" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-01")" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Đến ngày</label>
                            <input type="date" name="NgayKetThuc" class="form-control" value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd"))" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark">Lưu cài đặt</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Đặt ngân sách theo danh mục -->
<div class="modal fade" id="nganSachDanhMucModal" tabindex="-1" aria-labelledby="nganSachDanhMucLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="nganSachDanhMucLabel">
                    <i class="bi bi-plus-circle me-2"></i>Đặt ngân sách theo danh mục
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Home" asp-action="ThemNganSach" method="post">
                <div class="modal-body">
                    <!-- Danh mục chi tiêu -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn danh mục chi tiêu</label>
                        <select name="MaDanhMuc" class="form-select" id="budgetCategorySelect" required>
                            <option value="">-- Chọn danh mục --</option>
                            @if (ViewBag.DanhMucList != null)
                            {
                                foreach (var dm in ViewBag.DanhMucList)
                                {
                                    <option value="@dm.MaDanhMuc" data-icon="@dm.BieuTuong">@dm.BieuTuong @dm.TenDanhMuc</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Hạn mức ngân sách -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hạn mức ngân sách tối đa</label>
                        <div class="input-group">
                            <input type="number" name="SoTienHanMuc" class="form-control" placeholder="Ví dụ: 1000000" min="1000" required />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <small class="text-muted">Bạn sẽ được cảnh báo khi chi tiêu vượt quá hạn mức này</small>
                    </div>

                    <!-- Thời gian áp dụng -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Thời gian áp dụng</label>
                        <div class="row">
                            <div class="col-6">
                                <label class="form-label small text-muted">Từ ngày</label>
                                <input type="date" name="NgayBatDau" class="form-control form-control-sm" 
                                       value="@DateTime.Now.ToString("yyyy-MM-01")" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted">Đến ngày</label>
                                <input type="date" name="NgayKetThuc" class="form-control form-control-sm" 
                                       value="@(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1).ToString("yyyy-MM-dd"))" required />
                            </div>
                        </div>
                    </div>

                    <!-- Loại ngân sách (hidden, mặc định là danh mục) -->
                    <input type="hidden" name="LoaiNganSach" value="DanhMuc" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Lưu ngân sách</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Chi tiết ngân sách danh mục -->
<div class="modal fade" id="budgetDetailModal" tabindex="-1" aria-labelledby="budgetDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="budgetDetailLabel">
                    <i class="bi bi-wallet2 me-2"></i>Chi tiết ngân sách
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label small text-muted">Danh mục</label>
                    <p class="h6 mb-0" id="budgetCategoryName"></p>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Hạn mức ngân sách</label>
                    <p class="h5 mb-0 text-success" id="budgetAmount"></p>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label class="form-label small text-muted">Ngày bắt đầu</label>
                        <p class="mb-0" id="budgetStartDate"></p>
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Ngày kết thúc</label>
                        <p class="mb-0" id="budgetEndDate"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showBudgetDetail(categoryId, categoryName, budgetAmount, startDate, endDate) {
        document.getElementById('budgetCategoryName').textContent = categoryName;
        document.getElementById('budgetAmount').textContent = parseInt(budgetAmount).toLocaleString('vi-VN') + ' đ';
        document.getElementById('budgetStartDate').textContent = startDate;
        document.getElementById('budgetEndDate').textContent = endDate;
        
        var modal = new bootstrap.Modal(document.getElementById('budgetDetailModal'));
        modal.show();
    }

    function showNoBudgetAlert(categoryName) {
        alert('Bạn chưa thêm ngân sách vào danh mục: ' + categoryName);
    }

    document.addEventListener("DOMContentLoaded", function () {
        const radThang = document.getElementById("radNganSachThang");
        const radDanhMuc = document.getElementById("radNganSachDanhMuc");
        const khuVucDanhMuc = document.getElementById("khuVucChonDanhMuc");
        const selectDanhMuc = document.getElementById("selectMaDanhMuc");

        function toggleBudgetType() {
            if (radThang.checked) {
                khuVucDanhMuc.classList.add("d-none"); 
                selectDanhMuc.removeAttribute("required"); 
                selectDanhMuc.value = ""; 
            } else if (radDanhMuc.checked) {
                khuVucDanhMuc.classList.remove("d-none"); 
                selectDanhMuc.setAttribute("required", "required"); 
            }
        }

        radThang.addEventListener("change", toggleBudgetType);
        radDanhMuc.addEventListener("change", toggleBudgetType);
        
        
        toggleBudgetType();
    });
</script>

