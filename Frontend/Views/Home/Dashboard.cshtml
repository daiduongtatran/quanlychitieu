    align-items: center;
}

.category-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 18px;
    min-width: 40px;
}

.category-details {
    flex: 1;
}

.category-name {
    font-weight: 600;
    color: #2c3e50;
    margin: 0 0 3px 0;
    font-size: 14px;
}

.category-count {
    font-size: 12px;
    color: #7f8c8d;
    margin: 0;
}

.category-budget {
    font-size: 12px;
    color: #7f8c8d;
    margin: 0;
}

