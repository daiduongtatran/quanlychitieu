@model RegisterModel

@{
    ViewData["Title"] = "Đăng ký - Quản lý chi tiêu";
}

<div class="auth-container">
    <div class="auth-wrapper">
        <div class="auth-branding">
            <div class="auth-logo">
                <i class="bi bi-wallet-fill"></i>
            </div>
            <h1 class="auth-title">Quản lý chi tiêu</h1>
            <p class="auth-subtitle">Kiểm soát tài chính thông minh</p>
            
            <div class="auth-features mt-5">
                <div class="auth-feature">
                    <p>Quản lý chi tiêu dễ dàng</p>
                </div>
                <div class="auth-feature">
                    <p>Báo cáo chi tiết</p>
                </div>
                <div class="auth-feature">
                    <p>Bảo mật cao nhất</p>
                </div>
            </div>
        </div>

        <div class="auth-form-wrapper">
            <div class="auth-form-container">
                <h2 class="mb-2">Tạo tài khoản mới</h2>
                <p class="text-muted mb-4">Bắt đầu quản lý tài chính của bạn</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle"></i> Vui lòng kiểm tra lại thông tin
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Họ và tên</label>
                        <input asp-for="FullName" type="text" class="form-control" placeholder="Nhập họ và tên" required />
                        <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="your@email.com" required />
                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                        <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="0123456789" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required id="password" />
                        <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="AgreeToTerms" type="checkbox" class="form-check-input" id="agreeTerms" required />
                        <label class="form-check-label" for="agreeTerms">
                            Tôi đã đọc và đồng ý với Điều khoản Dịch vụ
                        </label>
                        <span asp-validation-for="AgreeToTerms" class="text-danger small d-block mt-1"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                        Tạo tài khoản
                    </button>
                </form>

                <p class="text-center text-muted mt-3 mb-0">
                    Đã có tài khoản? 
                    <a asp-action="Login" class="text-success text-decoration-none fw-bold">Đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            window.addEventListener('load', function () {
                var forms = document.querySelectorAll('form');
                Array.prototype.slice.call(forms).forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                    }, false);
                });
            });
        })();
    </script>
}
}
