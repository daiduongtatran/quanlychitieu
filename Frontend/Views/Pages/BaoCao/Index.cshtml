@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Báo cáo tài chính";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title">Báo cáo tài chính <i class="bi bi-bar-chart-line text-primary"></i></h1>
        <p class="page-subtitle">Phân tích dòng tiền và thói quen chi tiêu của bạn</p>
    </div>
    
    <form method="get" id="filterForm" class="d-flex gap-2">
        <select name="month" class="form-select bg-white shadow-sm border-0 fw-bold text-secondary" onchange="document.getElementById('filterForm').submit();">
            @for (int i = 1; i <= 12; i++)
            {
                if (ViewBag.SelectedMonth == i)
                {
                    <option value="@i" selected>Tháng @i</option>
                }
                else
                {
                    <option value="@i">Tháng @i</option>
                }
            }
        </select>
        <select name="year" class="form-select bg-white shadow-sm border-0 fw-bold text-secondary" onchange="document.getElementById('filterForm').submit();">
            @for (int i = DateTime.Now.Year - 2; i <= DateTime.Now.Year + 1; i++)
            {
                if (ViewBag.SelectedYear == i)
                {
                    <option value="@i" selected>Năm @i</option>
                }
                else
                {
                    <option value="@i">Năm @i</option>
                }
            }
        </select>
    </form>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-arrow-down-circle"></i></div>
            <div class="stat-content">
                <h5>Tổng Thu Nhập</h5>
                <p class="stat-value">@string.Format("{0:N0}", ViewBag.TongThu) ₫</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-arrow-up-circle"></i></div>
            <div class="stat-content">
                <h5>Tổng Chi Tiêu</h5>
                <p class="stat-value">@string.Format("{0:N0}", ViewBag.TongChi) ₫</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="bi bi-wallet2"></i></div>
            <div class="stat-content">
                <h5>Số Dư Tháng</h5>
                <p class="stat-value">@string.Format("{0:N0}", ViewBag.SoDu) ₫</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-5 mb-4">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pie-chart text-warning"></i> Cơ cấu chi tiêu</h5>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                @if (ViewBag.TongChi > 0)
                {
                    <div style="width: 80%; max-width: 300px;">
                        <canvas id="expensePieChart"></canvas>
                    </div>
                    
                    <div class="mt-4 w-100 category-list" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var item in ViewBag.ChiTieuList)
                        {
                            decimal percent = ViewBag.TongChi > 0 ? (item.TongTien / ViewBag.TongChi) * 100 : 0;
                            <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fs-4 text-secondary"><i class="@item.BieuTuong"></i></span>
                                    <span class="fw-semibold text-dark">@item.TenDanhMuc</span>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-danger">@string.Format("{0:N0}", item.TongTien) ₫</div>
                                    <div class="text-muted small">@percent.ToString("F1")%</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-folder2-open display-1 text-light"></i>
                        <p class="mt-3">Chưa có dữ liệu chi tiêu trong tháng này</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7 mb-4">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold"><i class="bi bi-graph-up text-primary"></i> Xu hướng Thu - Chi theo ngày</h5>
            </div>
            <div class="card-body">
                <div style="height: 400px; width: 100%;">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // 1. Cấu hình Biểu đồ Tròn (Pie Chart)
            const pieDataString = '@Html.Raw(ViewBag.PieData)';
            if (pieDataString && pieDataString !== '[]') {
                const pieCtx = document.getElementById('expensePieChart').getContext('2d');
                new Chart(pieCtx, {
                    type: 'doughnut',
                    data: {
                        labels: JSON.parse('@Html.Raw(ViewBag.PieLabels)'),
                        datasets: [{
                            data: JSON.parse(pieDataString),
                            backgroundColor: [
                                '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', 
                                '#9966FF', '#FF9F40', '#E7E9ED', '#8AC926'
                            ],
                            borderWidth: 2,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { display: false }, // Ẩn legend mặc định vì đã tạo list custom bên dưới
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        let label = context.label || '';
                                        if (label) { label += ': '; }
                                        label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.raw);
                                        return label;
                                    }
                                }
                            }
                        },
                        cutout: '65%' // Tạo khoảng trống ở giữa để giống Momo
                    }
                });
            }

            // 2. Cấu hình Biểu đồ Xu hướng (Bar Chart)
            const trendCtx = document.getElementById('trendChart').getContext('2d');
            new Chart(trendCtx, {
                type: 'bar',
                data: {
                    labels: JSON.parse('@Html.Raw(ViewBag.LineLabels)'),
                    datasets: [
                        {
                            label: 'Thu Nhập',
                            data: JSON.parse('@Html.Raw(ViewBag.LineThuData)'),
                            backgroundColor: 'rgba(39, 174, 96, 0.7)',
                            borderColor: '#27ae60',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Chi Tiêu',
                            data: JSON.parse('@Html.Raw(ViewBag.LineChiData)'),
                            backgroundColor: 'rgba(231, 76, 60, 0.7)',
                            borderColor: '#e74c3c',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false,
                    },
                    scales: {
    y: {
        beginAtZero: true,
        ticks: {
            callback: function(value) {
                return value.toLocaleString('vi-VN'); // Tự động thêm dấu chấm phân cách 100.000, 1.000.000
            }
        }
    }
},
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + 
                                           new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.raw);
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}